{
  "name": "migration-console",
  "version": "0.1.0",
  "description": "Control panel for database migrations: see what is pending, simulate exactly what a script will change, and apply it only after an explicit confirmation.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "migration-console": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ui.mjs",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mssql": "12.7.13",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/mssql": "9.1.9",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
